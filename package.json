{
  "name": "pharos-liquidation-watchdog",
  "version": "1.0.0",
  "description": "Agent-Native Liquidation Risk Sentinel and Interaction-Safety Monitor for DeFi Lending",
  "type": "module",
  "main": "dist/server.js",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.js",
    "start": "node dist/server.js",
    "serve": "node dist/server.js",
    "dev": "node --experimental-strip-types src/server/index.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/integration/*.test.ts"
  },
  "keywords": [
    "pharos",
    "defi",
    "liquidation",
    "watchdog",
    "aave-v3",
    "risk-monitor",
    "mcp",
    "agent-native",
    "sentinel"
  ],
  "author": "JimmyOgb",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
